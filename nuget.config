<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    TEMPORARY. The sample samples/GraphicsDemo takes this repository's own three packages, which
    are not on nuget.org yet, from here, as local builds (it consumes packages only, never the
    projects): WebGpu, WebGpu.Graphics and WebGpu.Animation. Local builds of exactly those three
    packages are taken from temp-packages (a folder git ignores) beside this file; everything
    else - the CodeBrix.WebPlatform packages included - comes from nuget.org. When the three
    packages are published: delete this file and the folder, and set the published version in
    the sample's project files. See TEMPORARY PACKAGES in MAINTAINER-README.txt beside this
    file.
  -->
  <packageSources>
    <add key="webgpu-temp-packages" value="temp-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="webgpu-temp-packages">
      <package pattern="CodeBrix.WebPlatform.WebGpu.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.WebGpu.Graphics.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.WebGpu.Animation.ApacheLicenseForever" />
    </packageSource>
  </packageSourceMapping>
</configuration>
