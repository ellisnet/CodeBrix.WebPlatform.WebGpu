<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    TEMPORARY. The packages of this repository depend on CodeBrix packages that are not on
    nuget.org yet: the nine CodeBrix.WebPlatform packages (1.0.324.293). The
    sample samples/GraphicsDemo also takes this repository's own three packages from here, as
    local builds (it consumes packages only, never the projects): WebGpu, WebGpu.Graphics and
    WebGpu.Animation. (CodeBrix.TomlParse, which the platform's Backend package depends on, is
    published and comes from nuget.org.) Local builds of exactly those twelve packages are taken from
    temp-packages (a folder git ignores) beside this file; everything else comes from
    nuget.org. When the packages are published: delete this file and the folder, and set the
    published versions in the project files. See TEMPORARY PACKAGES in MAINTAINER-README.txt
    beside this file.
  -->
  <packageSources>
    <add key="webgpu-temp-packages" value="temp-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="webgpu-temp-packages">
      <package pattern="CodeBrix.WebPlatform.Core.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.Backend.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.BackendMapper.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.FrontendBuilder.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.FrontendBuilder.LinuxX64.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.FrontendBuilder.LinuxArm64.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.FrontendBuilder.WindowsX64.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.FrontendBuilder.MacOSArm64.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.FrontendBuilder.MacOSX64.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.WebGpu.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.WebGpu.Graphics.ApacheLicenseForever" />
      <package pattern="CodeBrix.WebPlatform.WebGpu.Animation.ApacheLicenseForever" />
    </packageSource>
  </packageSourceMapping>
</configuration>
