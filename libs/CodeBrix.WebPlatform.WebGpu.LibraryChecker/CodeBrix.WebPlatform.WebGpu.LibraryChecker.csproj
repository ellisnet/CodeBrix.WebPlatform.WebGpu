<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The repository's maintainer tool: the licence and vendoring gate over what the repository
    holds outside samples/ (the wgpu crates the WebGpu package carries, the licence allowlist, the
    generated notices, the no-Node rule) and the re-vendoring command. It is NOT published and is
    no part of any package.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LibraryChecker</AssemblyName>
    <RootNamespace>CodeBrix.WebPlatform.WebGpu.LibraryChecker</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.RustTools.MitLicenseForever" Version="1.0.323.391" />
    <!--
      For the comparison with the platform only (the "platform" checks): the FrontendBuilder
      package copies the platform's crates into this project's output as
      frontend-crates/platform-crates.zip, and its assembly embeds the platform's Cargo.lock. Its
      version must be the platform version the packages of this repository pin Core to.
    -->
    <PackageReference Include="CodeBrix.WebPlatform.FrontendBuilder.ApacheLicenseForever" Version="1.0.329.452" />
  </ItemGroup>

</Project>
