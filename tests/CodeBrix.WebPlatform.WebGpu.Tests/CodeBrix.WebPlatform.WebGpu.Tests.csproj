<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.WebPlatform.WebGpu\CodeBrix.WebPlatform.WebGpu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.320.258" />
  </ItemGroup>

  <!--
    THE REAL-MATERIALIZE TESTS (Materialize/): they run the platform's PlatformFrontend.MaterializeAsync
    on a small frontend with this package's bundle registered. FrontendBuilder is referenced at
    the exact version of the Core package that src/CodeBrix.WebPlatform.WebGpu pins (published,
    from nuget.org); its buildTransitive targets copy the platform's
    crates archive beside the test assembly (frontend-crates/), as in a build program. The
    fixture backend is built with this project and found beside it. The crate set's Cargo.toml
    is copied beside the test assembly so that the test frontend names wgpu exactly as the crate
    set does.
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.WebPlatform.FrontendBuilder.ApacheLicenseForever" Version="1.0.327.240" />
    <ProjectReference Include="..\CodeBrix.WebPlatform.WebGpu.Tests.SampleBackend\CodeBrix.WebPlatform.WebGpu.Tests.SampleBackend.csproj" />
  </ItemGroup>

  <!--
    Also beside the test assembly: the first-party crate's Cargo.toml (its name, version and the
    dioxus line the test frontend copies), and the test frontend's main.rs, which uses the crate's
    public API.
  -->
  <ItemGroup>
    <None Include="..\..\src\CodeBrix.WebPlatform.WebGpu\Rust\webgpu-crates\Cargo.toml"
          Link="webgpu-crate-set\Cargo.toml"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <None Include="..\..\src\CodeBrix.WebPlatform.WebGpu\Rust\codebrix-webgpu\Cargo.toml"
          Link="codebrix-webgpu\Cargo.toml"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <None Update="Materialize\frontend-main.rs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
