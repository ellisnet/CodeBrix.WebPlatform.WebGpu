<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!--
      wwwroot holds ONLY the developer's own page at the site root (index.html, its stylesheet and
      the site icon). The built frontend applications are build output in frontend-built/ beside
      it (written by the build program; it ignores itself in git), which the Backend package serves
      and carries into the build and publish output. The SDK's static-web-assets layer is switched
      off so that a development or test host serves exactly those two folders.
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <RootNamespace>GraphicsDemo.Api</RootNamespace>
    <IsPackable>false</IsPackable>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The published CodeBrix.WebPlatform packages, from nuget.org: ONE version for all of them,
      the same as in the build program's project file (build/GraphicsDemo.BuildFrontend).
    -->
    <WebPlatformPackageVersion>1.0.332.326</WebPlatformPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The platform's backend library; it brings CodeBrix.WebPlatform.Core with it. -->
    <PackageReference Include="CodeBrix.WebPlatform.Backend.ApacheLicenseForever" Version="$(WebPlatformPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The sample's assets (GraphicsDemo.Assets, the sample's own project): the model files and the
      two models built in code, the panorama, the fonts, the pictures, the caption file, the SVG
      documents and the Lottie files, which the controllers serve.
    -->
    <ProjectReference Include="..\GraphicsDemo.Assets\GraphicsDemo.Assets.csproj" />
  </ItemGroup>

</Project>
